@startuml
!theme plain
skinparam backgroundColor transparent
skinparam defaultFontName Arial
skinparam arrowColor #2196F3
skinparam activityBackgroundColor #E3F2FD
skinparam activityBorderColor #1976D2
skinparam activityFontColor #0D47A1
skinparam noteBackgroundColor #FFF3E0
skinparam noteBorderColor #FF9800

' 노란색 강조 스타일 정의
skinparam activity {
  BackgroundColor<<highlight>> #FFEB3B
  BorderColor<<highlight>> #F57F17
  FontColor<<highlight>> #E65100
}

title 냉장고 관리 앱 사용자 플로우 다이어그램

start

:앱 실행;

if (로그인 상태?) then (로그인됨)
  :메인 화면 진입;
else (미로그인)
  :로그인 화면;
  
  if (로그인 방식 선택) then (Google 로그인)
    :Google OAuth 인증;
  else (이메일 로그인)
    :이메일/비밀번호 입력;
  endif
  
  if (신규 사용자?) then (예)
    :닉네임 설정;
    :권한 요청 (카메라, 저장소);
  else (아니오)
  endif
  
  :메인 화면 진입;
endif

note right
  메인 화면은 3개 탭으로 구성:
  - 통계 (기본)
  - 그룹 목록
  - 마이페이지
end note

partition "메인 기능 영역" {
  
  if (사용자 선택) then (통계 화면)
    :글로벌 통계 화면;
    :그룹별/월별 통계 조회; <<highlight>>
    
  elseif (그룹 목록) then
    :그룹 목록 화면;
    
    if (그룹 선택) then (기존 그룹 선택)
      :그룹 상세 화면;
      :냉장고 선택;
      :냉장고 구획 화면;
      
      partition "냉장고 관리" {
        if (사용자 액션) then (바코드 스캔)
          :바코드 스캐너 실행;
          :Mobile Scanner로 바코드 인식; <<highlight>>
          
          if (바코드 인식 성공?) then (성공)
            :SERP API로 상품 정보 검색; <<highlight>>
            :상품 상세 정보 표시;
            :냉장고에 식품 추가;
          else (실패)
            :수동 입력 화면;
            :직접 식품 정보 입력;
          endif
          
        elseif (영수증 스캔) then
          :영수증 스캐너 화면;
          :Google ML Kit으로 텍스트 인식; <<highlight>>
          :Groq AI로 데이터 후처리; <<highlight>>
          :인식된 식품 목록 표시;
          :선택된 식품들 냉장고에 추가;
          
        elseif (식품 검색) then
          :식품 검색 화면;
          :검색어 입력;
          :검색 결과 표시;
          :선택한 식품 냉장고에 추가;
          
        elseif (식품 관리) then
          :식품 목록 조회;
          :식품 정보 수정/삭제;
          :유통기한 관리;
        endif
      }
      
    else (새 그룹 생성)
      :그룹 생성 화면;
      :그룹 정보 입력;
      :그룹 생성 완료;
    endif
    
  else (마이페이지)
    :프로필 화면;
    
    if (사용자 선택) then (프로필 수정)
      :아바타 선택 화면;
      :닉네임 변경;
      :역할 설정;
      
    elseif (개인 통계) then
      :개인 통계 화면;
      :사용 패턴 분석;
      
    elseif (메모 관리) then
      :메모 목록 화면;
      :메모 작성/수정;
      
    else (로그아웃)
      :로그아웃 처리;
      :로그인 화면으로 이동;
      stop
    endif
  endif
}

partition "백그라운드 서비스" {
  note left
    Firebase Services:
    - Authentication (사용자 인증)
    - Firestore (데이터 저장)
    - Storage (이미지 저장)
    - Messaging (푸시 알림)
    - Functions (서버리스 로직)
  end note
  
  :유통기한 알림 서비스; <<highlight>>
  :데이터 실시간 동기화; <<highlight>>
  :통계 데이터 업데이트;
}

:앱 사용 지속;

stop

@enduml
