  // 바코드 스캔 기능
  Future<void> _scanBarcode() async {
    try {
      final result = await Navigator.push(
        context,
        MaterialPageRoute(
          builder: (context) => BarcodeScannerScreen(
            onBarcodeDetected: (String barcode) async {
              Navigator.pop(context);
              await _processBarcodeResult(barcode);
            },
          ),
        ),
      );
    } catch (e) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('바코드 스캔 중 오류가 발생했습니다: $e'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

  // 바코드 스캔 결과 처리
  Future<void> _processBarcodeResult(String barcodeValue) async {
    try {
      // 로딩 다이얼로그 표시
      showDialog(
        context: context,
        barrierDismissible: false,
        builder: (BuildContext context) {
          return Dialog(
            child: Padding(
              padding: EdgeInsets.all(20),
              child: Column(
                mainAxisSize: MainAxisSize.min,
                children: [
                  CircularProgressIndicator(),
                  SizedBox(height: 16),
                  Text('제품 정보를 가져오는 중...'),
                ],
              ),
            ),
          );
        },
      );

      final barcodeService = BarcodeService();
      final serpService = SerpSearchService();
      
      // 바코드 타입 감지
      final barcodeType = barcodeService.detectBarcodeType(barcodeValue);
      
      // 기존 바코드 확인
      final existingBarcode = await barcodeService.findExistingBarcode(barcodeValue, barcodeType);
      
      String foodName = '';
      String imageUrl = '';
      
      if (existingBarcode != null) {
        // 기존 바코드가 있으면 해당 정보 사용
        foodName = existingBarcode.foodName;
        imageUrl = existingBarcode.imageUrl;
      } else {
        // 새로운 바코드면 SERP API로 검색
        final productInfo = await serpService.searchProductByBarcode(barcodeValue);
        foodName = productInfo['foodName'] ?? '알 수 없는 제품';
        imageUrl = productInfo['imageUrl'] ?? '';
      }
      
      // 바코드 정보 저장
      final savedBarcode = await barcodeService.saveBarcodeToFirestore(
        barcodeValue,
        barcodeType,
        foodName: foodName,
        imageUrl: imageUrl,
      );
      
      // 로딩 다이얼로그 닫기
      Navigator.of(context).pop();
      
      // 바로 재료 추가 다이얼로그 표시
      _showAddIngredientFromBarcode(savedBarcode);
      
    } catch (e) {
      // 로딩 다이얼로그가 열려있으면 닫기
      if (Navigator.canPop(context)) {
        Navigator.of(context).pop();
      }
      
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('제품 정보를 가져오는 중 오류가 발생했습니다: $e'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

  // 바코드 정보로 재료 추가 다이얼로그
  void _showAddIngredientFromBarcode(BarcodeModel barcode) {
    final nameController = TextEditingController(text: barcode.foodName.isNotEmpty ? barcode.foodName : '알 수 없는 제품');
