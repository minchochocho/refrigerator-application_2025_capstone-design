                  backgroundColor: direction == DismissDirection.startToEnd 
                      ? Colors.green[600] 
                      : Colors.red[600],
                  foregroundColor: Colors.white,
                ),
                child: Text(actionText),
              ),
            ],
          ),
        );
      },
      child: Container(
        key: ValueKey('${ingredient['id']}_${ingredient['imagePath']}_${ingredient['name']}'), // 실시간 업데이트를 위한 고유 키
