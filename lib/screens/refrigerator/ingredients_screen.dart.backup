  @override
  void initState() {
    super.initState();
    _currentCompartmentName = widget.compartmentName; // 초기 칸 이름 설정
    _scrollController = ScrollController();
    _initializeStream();
  }
  
  @override
  void dispose() {
    _scrollController.dispose();
    super.dispose();
  }
  
  // 실시간 스트림 초기화
  void _initializeStream() {
    print('실시간 스트림 초기화 시작');
    _ingredientsStream = _refrigeratorService.getIngredientsForCompartmentStream(
      widget.roomId,
      widget.refrigeratorName,
      widget.compartmentIndex,
    );
    print('스트림 설정 완료');
  }
  
  // 재료 데이터 로드
  Future<void> _loadIngredients() async {
    setState(() {
      _isLoading = true;
    });
    
    try {
      final ingredientsList = await _refrigeratorService.getIngredientsForCompartment(
        widget.roomId,
        widget.refrigeratorName,
        widget.compartmentIndex,
      );
      
      if (mounted) {
        setState(() {
          _ingredients = ingredientsList;
          // 검색 상태 유지
          if (_searchQuery.isEmpty) {
            _filteredIngredients = ingredientsList;
          } else {
            _filterIngredients(_searchQuery);
          }
        });
      }
    } catch (e) {
      print('재료 로드 오류: $e');
    } finally {
      if (mounted) {
        setState(() {
          _isLoading = false;
        });
      }
    }
  }
  
  // 검색 필터링
  void _filterIngredients(String query) {
    setState(() {
      _searchQuery = query;
      if (query.isEmpty) {
        _filteredIngredients = _ingredients;
      } else {
        _filteredIngredients = _ingredients.where((ingredient) {
          final name = ingredient['name']?.toString().toLowerCase() ?? '';
          final memo = ingredient['memo']?.toString().toLowerCase() ?? '';
          final searchLower = query.toLowerCase();
          
          return name.contains(searchLower) || memo.contains(searchLower);
        }).toList();
      }
    });
  }
  
  // 스크롤 위치 저장
  void _saveScrollPosition() {
    if (_scrollController.hasClients) {
      _savedScrollPosition = _scrollController.offset;
    }
  }
  
  // 스크롤 위치 복원
  void _restoreScrollPosition() {
    if (_scrollController.hasClients && _savedScrollPosition > 0) {
      // 여러 번 시도하여 안정적으로 복원
      int attempts = 0;
      void tryRestore() {
        if (_scrollController.hasClients && attempts < 5) {
          _scrollController.animateTo(
            _savedScrollPosition,
            duration: Duration(milliseconds: 150),
            curve: Curves.easeOut,
          );
        } else if (attempts < 5) {
          attempts++;
          Future.delayed(Duration(milliseconds: 50), tryRestore);
        }
      }
      tryRestore();
    }
  }

  // 카드 높이 계산 (유통기한 상태에 따라 동적 크기)
  double _calculateCardHeight(Map<String, dynamic> ingredient) {
    final DateTime? expiryDate = ingredient['expiryDate']?.toDate();
    final DateTime? manufactureDate = ingredient['manufactureDate']?.toDate();
    final String memo = ingredient['memo']?.toString() ?? '';
    final bool isExpiring = expiryDate != null && _calculateDaysLeft(expiryDate) <= 3;
    final bool isExpired = expiryDate != null && _calculateDaysLeft(expiryDate) < 0;
    
    // 실제 UI 구조 기반 정확한 높이 계산
    double height = 0;
    
    // 1. 컨테이너 패딩 (상단)
    height += (isExpired || isExpiring) ? 20 : 16;
    
    // 2. 메인 Row 높이 (이미지 48px + 텍스트 영역)
    double textHeight = 0;
    textHeight += 20; // 식품명 (fontSize: 16, fontWeight: bold)
    textHeight += 4;  // SizedBox(height: 4)
    textHeight += 18; // 수량 텍스트 (fontSize: 14)
    
    if (manufactureDate != null) {
      textHeight += 2 + 16; // SizedBox + 제조일 텍스트
    }
    
    if (expiryDate != null) {
      textHeight += 2 + 16; // SizedBox + 유통기한 텍스트
    }
    
    if (memo.isNotEmpty) {
      textHeight += 2 + 18; // SizedBox + 메모 텍스트 (maxLines: 2)
      if (ingredient['memoAuthor'] != null) {
        textHeight += 1 + 13; // 작성자 정보
      }
      if (ingredient['memoCreatedAt'] != null || ingredient['memoUpdatedAt'] != null) {
        textHeight += 1 + 13; // 시간 정보
      }
    }
    
    // Row 높이는 이미지(48px)와 텍스트 영역 중 더 큰 값
    height += math.max(48, textHeight);
    
    // 3. 컨테이너 패딩 (하단)
    height += (isExpired || isExpiring) ? 20 : 16;
    
    // 4. 컨테이너 마진 (하단)
    height += 16;
    
    return height;
  }

  // 누적 스크롤 위치 계산 (각 카드의 실제 크기 고려)
  double _calculateCumulativeOffset(int targetIndex) {
    double totalOffset = 0.0;
    
    print('🧮 === 누적 오프셋 계산 시작 ===');
    print('🧮 타겟 인덱스: $targetIndex');
    
    // 타겟 인덱스까지의 모든 카드 높이 누적 (패딩은 제외)
    for (int i = 0; i < targetIndex && i < _filteredIngredients.length; i++) {
      double cardHeight = _calculateCardHeight(_filteredIngredients[i]);
      totalOffset += cardHeight;
      
      print('🧮   [$i] ${_filteredIngredients[i]['name']}: ${cardHeight}px (누적: ${totalOffset}px)');
    }
    
    print('🧮 최종 누적 오프셋: $totalOffset (패딩 제외)');
    
    return totalOffset;
  }

  // 특정 식품으로 스크롤 (정확히 상단 정렬)
  void _scrollToIngredient(String targetId) {
    if (!_scrollController.hasClients || _filteredIngredients.isEmpty) {
      // 스크롤 컨트롤러나 데이터가 준비되지 않은 경우 재시도
      Future.delayed(Duration(milliseconds: 500), () {
        _scrollToIngredient(targetId);
      });
      return;
    }

    // 타겟 식품의 인덱스 찾기
    int targetIndex = _filteredIngredients.indexWhere(
      (ingredient) => ingredient['id'] == targetId,
    );

    if (targetIndex != -1) {
      final String id = _filteredIngredients[targetIndex]['id'];
      final key = _itemKeysById[id];
      // 키가 준비되어 있으면 해당 위젯의 상단으로 정확히 스크롤
      if (key != null && key.currentContext != null) {
        Scrollable.ensureVisible(
          key.currentContext!,
          alignment: 0.0, // 상단 정렬
          duration: Duration(milliseconds: 600),
          curve: Curves.easeInOut,
        ).then((_) => _highlightIngredient(targetId));
        return;
      }
      // 키가 아직 준비되지 않았다면 기존 방식으로 백업 스크롤
      Future.delayed(Duration(milliseconds: 120), () {
        _performSimpleScroll(targetIndex, targetId);
      });
    } else {
      print('⚠️ 타겟 제품을 찾을 수 없습니다: $targetId');
      print('⚠️ 현재 _filteredIngredients: ${_filteredIngredients.map((e) => e['name']).toList()}');
    }
  }

  // 간단하고 정확한 스크롤 수행
  void _performSimpleScroll(int targetIndex, String targetId) {
    // 첫 번째 카드는 무조건 0 (최상단)
    if (targetIndex == 0) {
      print('🎯 첫 번째 카드로 스크롤: 위치 0');
      _scrollController.animateTo(0, duration: Duration(milliseconds: 800), curve: Curves.easeInOut)
        .then((_) => _highlightIngredient(targetId));
      return;
    }

    // 실제 카드의 누적 높이를 정확하게 계산
    double targetOffset = _calculateCumulativeOffset(targetIndex);
    double maxScroll = _scrollController.position.maxScrollExtent;
    
    // 타겟 카드의 상단이 정확히 화면 상단에 오도록 계산
    // _calculateCumulativeOffset에서 이미 패딩을 고려했으므로 추가 조정 불필요
    double finalOffset = math.min(targetOffset, maxScroll);
    
    // 스크롤 길이가 부족한 경우 최대한 위로 이동
    if (targetOffset > maxScroll) {
      finalOffset = maxScroll;
      print('🎯 스크롤 길이 부족 - 최대한 위로 이동: maxScroll=$maxScroll');
    }
    
    print('🎯 === 최종 스크롤 계산 ===');
    print('   타겟 인덱스: $targetIndex');
    print('   누적 오프셋: $targetOffset');
    print('   최대 스크롤: $maxScroll');
    print('   최종 스크롤 위치: $finalOffset');
    
    _scrollController.animateTo(
      finalOffset,
      duration: Duration(milliseconds: 800),
      curve: Curves.easeInOut,
    ).then((_) => _highlightIngredient(targetId));
  }

  // 특정 식품 하이라이트 (시각적 효과)
  void _highlightIngredient(String targetId) {
    setState(() {
      _highlightedIngredientId = targetId;
    });
    
    // 3초 후 하이라이트 제거
    Future.delayed(Duration(seconds: 3), () {
      if (mounted) {
        setState(() {
          _highlightedIngredientId = null;
        });
      }
    });
  }

  // 이미지 표시 헬퍼 함수 (URL, Asset, 로컬 파일 지원)
  Widget _buildIngredientImage(String imagePath, double width, double height, {Widget? fallbackIcon}) {
    print(' 이미지 렌더링 시도: $imagePath');
    if (imagePath.startsWith('data:image/')) {
      print('   Base64 Data URL로 렌더링');
      try {
        // Base64 Data URL에서 base64 부분 추출
        final base64String = imagePath.split(',')[1];
        final bytes = base64Decode(base64String);
        return Image.memory(
          bytes,
          key: ValueKey(imagePath), // 캐시 키 추가로 실시간 업데이트 보장
          width: width,
          height: height,
          fit: BoxFit.cover,
          errorBuilder: (context, error, stackTrace) => Container(
            padding: EdgeInsets.all(12),
            child: fallbackIcon ?? Icon(Icons.image_not_supported, size: 24),
          ),
        );
      } catch (e) {
        print('   ❌ Base64 디코딩 실패: $e');
        return Container(
          padding: EdgeInsets.all(12),
          child: fallbackIcon ?? Icon(Icons.image_not_supported, size: 24),
        );
      }
    } else if (imagePath.startsWith('http')) {
      print('   HTTP 이미지로 렌더링');
      final int? cacheW = (width.isFinite && width > 0) ? (width * 2).round() : null;
      final int? cacheH = (height.isFinite && height > 0) ? (height * 2).round() : null;
      return CachedNetworkImage(
        imageUrl: imagePath,
        key: ValueKey(imagePath), // 캐시 키 추가로 실시간 업데이트 보장
        width: width.isFinite ? width : null,
        height: height.isFinite ? height : null,
        fit: BoxFit.cover,
        memCacheWidth: cacheW,
        memCacheHeight: cacheH,
        httpHeaders: {'Cache-Control': 'no-cache'}, // HTTP 캐시 비활성화
        placeholder: (context, url) => Container(
          width: width.isFinite ? width : null,
          height: height.isFinite ? height : null,
          color: Colors.grey[200],
          child: Center(child: CircularProgressIndicator(strokeWidth: 2)),
        ),
        errorWidget: (context, url, error) => Container(
          padding: EdgeInsets.all(12),
          child: fallbackIcon ?? Icon(Icons.image_not_supported, size: 24),
        ),
      );
    } else if (imagePath.startsWith('asset://')) {
      print('   📱 Asset 이미지로 렌더링');
      return Image.asset(
        imagePath.replaceFirst('asset://', ''),
        key: ValueKey(imagePath), // 캐시 키 추가
        width: width,
        height: height,
        fit: BoxFit.cover,
        errorBuilder: (context, error, stackTrace) => Container(
          padding: EdgeInsets.all(12),
          child: fallbackIcon ?? Icon(Icons.image_not_supported, size: 24),
        ),
      );
    } else {
      print('   📁 로컬 파일로 렌더링');
      return Image.file(
        File(imagePath),
        key: ValueKey(imagePath), // 캐시 키 추가
        width: width,
        height: height,
        fit: BoxFit.cover,
        errorBuilder: (context, error, stackTrace) => Container(
          padding: EdgeInsets.all(12),
          child: fallbackIcon ?? Icon(Icons.image_not_supported, size: 24),
        ),
      );
    }
  }

  // 식품명으로 아이콘 찾기 (개선됨)
  IconData _getFoodIcon(String foodName) {
    final lowerFoodName = foodName.toLowerCase();
    
    // 정확한 매치 먼저 시도 (대소문자 무시)
    for (String category in _foodCategoryIcons.keys) {
      if (category.toLowerCase() == lowerFoodName) {
        return _foodCategoryIcons[category]!;
      }
    }
    
    // 부분 매치 시도 (대소문자 무시)
    for (String category in _foodCategoryIcons.keys) {
      if (lowerFoodName.contains(category.toLowerCase()) || 
          category.toLowerCase().contains(lowerFoodName)) {
        return _foodCategoryIcons[category]!;
      }
    }
    
    // 단어별 매치 시도
    final foodWords = lowerFoodName.split(' ');
    for (String word in foodWords) {
      for (String category in _foodCategoryIcons.keys) {
        if (category.toLowerCase().contains(word) || 
            word.contains(category.toLowerCase())) {
          return _foodCategoryIcons[category]!;
        }
      }
    }
    
    // 기본 아이콘
    return Icons.fastfood;
  }
  
